BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=next_secret_abc
BACKEND_URL=http://localhost:8000
BACKEND_RT_URL=http://localhost:8002
NEXT_OTEL_FETCH_DISABLED=1
SHARED_SECRET_TOKEN=some_secret

# these must match what you have in your docker-compose-local-dev.yml for postgres
# postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@{host}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL="postgres://postgres:postgres_passwordabc@localhost:5433/postgres"
DATABASE_MAX_CONNECTIONS=10
FORCE_RUN_MIGRATIONS=false
FORCE_EMAIL_AUTH=false

# Optional. Postgres schema all tables live in (applied as the connection
# search_path). Defaults to "public". Must match the app-server's POSTGRES_SCHEMA.
# When set to a non-public schema, migrations are also tracked inside it
# (drizzle.__drizzle_migrations moves into the schema) so a Laminar database can
# coexist with another Drizzle-managed service in the same instance.
# POSTGRES_SCHEMA=public
# Set to false if the schema is pre-provisioned or the DB role lacks CREATE.
# POSTGRES_CREATE_SCHEMA=true

# must be 32 bytes (64 hex characters) long
AEAD_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# replace with FULL if you are testing with a full stack
# ENVIRONMENT=FULL
ENVIRONMENT=LITE
CLICKHOUSE_USER=ch_user
CLICKHOUSE_PASSWORD=ch_passwd
CLICKHOUSE_URL=http://localhost:8123
# Live ClickHouse → Postgres proxy (PostgreSQL database engine). Host/port are
# from the ClickHouse server's perspective: with compose that is `postgres:5432`,
# not localhost:5433. Same names on Cloud (Supabase) and self-hosted.
CLICKHOUSE_POSTGRES_HOST=postgres
CLICKHOUSE_POSTGRES_PORT=5432
CLICKHOUSE_POSTGRES_DATABASE=postgres
CLICKHOUSE_POSTGRES_USER=clickhouse_ro
CLICKHOUSE_POSTGRES_PASSWORD=clickhouse_ro_passwordabc
# CLICKHOUSE_POSTGRES_SCHEMA=public
# CLICKHOUSE_POSTGRES_STATEMENT_TIMEOUT=15s
# CLICKHOUSE_POSTGRES_CONNECTION_LIMIT=10
# for auth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_OKTA_CLIENT_ID=
AUTH_OKTA_CLIENT_SECRET=
AUTH_OKTA_ISSUER=
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=

# for s3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_EXPORTS_BUCKET=

REDIS_URL=
OPENAI_API_KEY=

# Leave unset (false) on self-hosted deployments: enables the workspace
# "LLM profiles" settings page and the profile/model picker on signals.
# Laminar Cloud sets true. Must match the app-server's LAMINAR_CLOUD.
# LAMINAR_CLOUD=false

# AI features (SQL generation, span previews, render templates, signals, etc.)
# Which profile/model each feature runs on comes from the llm_feature_routes
# table (rows are edited directly in the database); the LLM_PROVIDER env below
# is the fallback for features without a route. Global routes point at LLM
# profiles in the Laminar-internal workspace named here (same value as the
# app-server's); setting it enables the AI features without an LLM_PROVIDER:
# LLM_SYSTEM_WORKSPACE_ID=
#
# Pick one provider: openai | gemini | bedrock | azure_chat_completions |
# azure_responses | azure_anthropic.
# LLM_MODEL_* overrides are optional — per-provider defaults apply when unset.
#
# openai also works with OpenAI-compatible gateways (LiteLLM, OpenRouter,
# vLLM, etc.) via LLM_BASE_URL.
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:4000
# LLM_API_KEY=
# LLM_MODEL_SMALL=
# LLM_MODEL_MEDIUM=
# LLM_MODEL_LARGE=
#
# bedrock reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION
# (no LLM_API_KEY).
# LLM_PROVIDER=bedrock
#
# The azure_* providers all read LLM_API_KEY plus the resource name (or a full
# endpoint URL) and differ only in the API shape they talk to on that one
# resource; LLM_MODEL_* are deployment names.
#   azure_chat_completions -> /openai/v1/chat/completions
#   azure_responses        -> /openai/v1/responses
#   azure_anthropic        -> /anthropic/v1/messages (Claude)
# LLM_PROVIDER=azure_chat_completions
# AZURE_RESOURCE_ID=
# AZURE_BASE_URL=
# AZURE_API_VERSION=

QUICKWIT_SEARCH_URL=
