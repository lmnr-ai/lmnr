# postgres://user:password@host:port/dbname
DATABASE_URL="postgres://postgres:postgres_passwordabc@localhost:5433/postgres"

# Optional. Postgres schema all tables live in (applied as the connection
# search_path). Defaults to "public". Must match the frontend's POSTGRES_SCHEMA.
# POSTGRES_SCHEMA=public

PORT=8000
GRPC_PORT=8001
# port for the consumer side of the queue, serves realtime (RT) endpoint
CONSUMER_PORT=8002

RABBITMQ_URL=amqp://admin:adminpasswd@localhost:5672/%2f

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=ch_user
CLICKHOUSE_PASSWORD=ch_passwd
CLICKHOUSE_RO_USER=ch_user
CLICKHOUSE_RO_PASSWORD=ch_passwd
# Optional: lets SQL queries read signals and entity names from Postgres; set both to enable. See README.md#sql-access-to-postgres-entities-optional
# CLICKHOUSE_POSTGRES_USER=clickhouse_ro
# CLICKHOUSE_POSTGRES_PASSWORD=<choose a strong password>
# CLICKHOUSE_POSTGRES_HOST=postgres
# CLICKHOUSE_POSTGRES_PORT=5432
# CLICKHOUSE_POSTGRES_DATABASE=postgres
# CLICKHOUSE_POSTGRES_SCHEMA=public
# CLICKHOUSE_POSTGRES_STATEMENT_TIMEOUT=15s
# CLICKHOUSE_POSTGRES_CONNECTION_LIMIT=10

SHARED_SECRET_TOKEN=some_secret
# must be exactly 32 bytes (64 hex characters)
AEAD_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENVIRONMENT=FULL
# Leave unset (false) on self-hosted deployments: signals can then pin a
# workspace "LLM profile" configured in the UI. Laminar Cloud sets true.
# LAMINAR_CLOUD=false

# Which model each LLM-backed feature (signals, extraction, agent, ...) runs on
# is read from the llm_feature_routes table (rows are edited directly in the
# database); LLM_PROVIDER is the fallback for features without a route. Global
# routes (workspace_id NULL) point at LLM profiles in this Laminar-internal
# workspace; setting it enables LLM-backed features without an LLM_PROVIDER:
# LLM_SYSTEM_WORKSPACE_ID=

# Optional, if you want to use Redis for caching. Create a Redis/Valkey instance and set the URL here.
# REDIS_URL=redis://localhost:6379

QUICKWIT_INGEST_URL=http://localhost:7281 # grpc
QUICKWIT_SEARCH_URL=http://localhost:7280 # http
QUICKWIT_SPANS_INDEX_ID=spans_v2
# Commit every ingest batch immediately. Set false to let the index's commit_timeout_secs decide.
# QUICKWIT_FORCE_COMMIT=true

# Optional. When set, spans whose attributes carry `lmnr.should_remove_pii=true`
# have their input/output redacted via the pii-redactor gRPC service before
# CH/Quickwit ingest. Service contract lives in `pii-redactor/`.
# PII_REDACTOR_URL=http://localhost:8910

# Optional, set this to enable the reports feature
# ENABLE_REPORTS=true

# Optional, agent versioning: mints agents and versions from production agent prompts.
# AGENT_VERSIONING_ENABLED=true

# Optional, set this to enable the email notifications feature
# RESEND_API_KEY=

# Optional, set this to enable the slack notifications feature
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_ENCRYPTION_KEY=

# Optional, set this to the public URL of the frontend for the links in slack/email notifications
# NEXT_PUBLIC_URL=https://laminar-fe.mywebsite.com

# Optional, hosted evals (/v1/hosted-evals/*): Harbor trials in Daytona sandboxes,
# proxied through the app-server. Remote runs also need S3 (AWS creds + S3_EXPORTS_BUCKET).
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# HOSTED_EVALS_MAX_RUN_MINUTES=720
# HOSTED_EVALS_MAX_SANDBOXES_PER_PROJECT=50
# HOSTED_EVALS_MAX_SANDBOX_CPUS=4
# HOSTED_EVALS_MAX_SANDBOX_MEMORY_GB=8
# HOSTED_EVALS_MAX_SANDBOX_DISK_GB=10
# Laminar API URL remote-run sandboxes call back to; unset means Laminar Cloud.
# HOSTED_EVALS_LMNR_BASE_URL=
# npm spec remote runs install instead of lmnr-cli@<the requesting CLI's version>.
# HOSTED_EVALS_CLI_PACKAGE=
# Images lmnr-cli pushes go to the AWS account's ECR (AWS_REGION, default credential chain)
# unless a registry is set here; repositories are <prefix>/<project id>.
# HOSTED_EVALS_REGISTRY_URL=
# HOSTED_EVALS_REGISTRY_USERNAME=
# HOSTED_EVALS_REGISTRY_PASSWORD=
# HOSTED_EVALS_REGISTRY_REPOSITORY_PREFIX=lmnr-hosted-evals
